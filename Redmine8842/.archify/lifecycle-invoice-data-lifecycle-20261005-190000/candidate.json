  "cards": [
    {
      "dot": "cyan",
      "title": "Editable condition",
      "items": [
        "Search result can show Correction only when SlipCorrectionAvailabilityFlg is 1.",
        "Normal header rows derive it from SlipRevisionFlg != '1'.",
        "Error/work rows derive it from FixDate IS NULL."
      ]
    },
    {
      "dot": "amber",
      "title": "Search condition effect",
      "items": [
        "Non-empty date, store, department, media, slip number, or slip type filters narrow the query.",
        "LogicalDelFlg <> '1' is required for both normal and error table paths.",
        "When history display is not enabled, normal header rows with SlipRevisionFlg='1' are filtered out."
      ]
    },
    {
      "dot": "rose",
      "title": "Cancel outcome",
      "items": [
        "Unsaved cancel stops with ERRCSARB0273.",
        "Saved cancel sets CancelMode=1 and creates a red slip path.",
        "After cancel, SARSlipHeader.SlipRevisionFlg and SARSlipHeaderError.FixDate make correction unavailable."
      ]
    }
  ]
